<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>                 <string>eqviz</string>
    <key>CFBundleDisplayName</key>          <string>eqviz</string>
    <key>CFBundleExecutable</key>           <string>eqviz</string>
    <key>CFBundleIdentifier</key>           <string>local.eqviz.visualizer</string>
    <key>CFBundleIconFile</key>             <string>eqviz</string>
    <key>CFBundlePackageType</key>          <string>APPL</string>
    <key>CFBundleShortVersionString</key>   <string>1.0</string>
    <key>CFBundleVersion</key>              <string>1</string>
    <key>LSMinimumSystemVersion</key>       <string>11.0</string>
    <key>LSApplicationCategoryType</key>    <string>public.app-category.education</string>
    <key>NSHighResolutionCapable</key>      <true/>
    <key>NSHumanReadableCopyright</key>     <string>Equation visualizer</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>        <string>eqviz project</string>
            <key>CFBundleTypeExtensions</key>  <array><string>eqviz</string></array>
            <key>CFBundleTypeRole</key>        <string>Editor</string>
        </dict>
    </array>
</dict>
</plist>
